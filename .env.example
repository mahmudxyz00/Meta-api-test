# vibes-api environment configuration
# Copy this file to .env and fill in your values

# Required: Your vibes.ai meta_session cookie value
# Get it from: DevTools → Application → Cookies → vibes.ai → meta_session
VIBES_META_SESSION=your-cookie-value-here

# Optional: API key for authenticating requests to your deployed API
# If set, clients must send "X-API-Key: <key>" header
# If not set, no auth is required (open access)
VIBES_API_KEY=

# Optional: File path to persist the auto-refreshed cookie
# This allows the session to survive server restarts
VIBES_COOKIE_FILE=/data/.vibes_cookie

# Optional: Background cookie refresh interval in seconds (default 1500 = 25 min)
VIBES_REFRESH_INTERVAL=1500

# Server settings
HOST=0.0.0.0
PORT=8000
