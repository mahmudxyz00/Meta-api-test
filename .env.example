# Required: Your vibes.ai meta_session cookie value
VIBES_META_SESSION=your-cookie-value-here

# Optional: API key for authenticating requests
VIBES_API_KEY=

# Optional: File path to persist the auto-refreshed cookie
VIBES_COOKIE_FILE=/data/.vibes_cookie

# Optional: Background refresh interval (default 1500 = 25 min)
VIBES_REFRESH_INTERVAL=1500

# Server settings
HOST=0.0.0.0
PORT=8000
